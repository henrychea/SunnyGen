{
  "name": "sunnygen",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "Henry Chea",
  "scripts": {
    "dev": "turbo run dev --filter=@sunnygen/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@sunnygen/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.2",
      "source-map-js": "1.2.2"
    }
  }
}
