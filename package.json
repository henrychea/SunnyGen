{
  "name": "sunnygen",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "Henry Chea",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@sunnygen/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@sunnygen/web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8"
  }
}
