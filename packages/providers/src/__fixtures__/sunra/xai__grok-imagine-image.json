{
  "openapi": "3.0.0",
  "info": {
    "title": "xAI Grok Imagine Image API",
    "docs": "https://oapi.sunra.ai/main/xai/grok-imagine-image/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/xai/grok-imagine-image/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "1:1",
                      "2:1",
                      "20:9",
                      "19.5:9",
                      "16:9",
                      "4:3",
                      "3:2",
                      "2:3",
                      "3:4",
                      "9:16",
                      "9:19.5",
                      "9:20",
                      "1:2"
                    ],
                    "default": "1:1"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "jpeg"
                  },
                  "quality": {
                    "type": "string",
                    "enum": ["standard", "high"],
                    "default": "standard"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-image/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 3,
                    "minItems": 1
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "jpeg"
                  },
                  "quality": {
                    "type": "string",
                    "enum": ["standard", "high"],
                    "default": "standard"
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
