{
  "openapi": "3.0.0",
  "info": {
    "title": "Qwen Image 2.1 API",
    "docs": "https://oapi.sunra.ai/main/qwen/qwen-image-2.1/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/qwen/qwen-image-2.1/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"],
                    "default": "1:1"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["1K", "2K"],
                    "default": "1K"
                  },
                  "guidance_scale": {
                    "type": "number",
                    "maximum": 10.0,
                    "minimum": 1.0,
                    "default": 1
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 2147483647.0,
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["png", "jpeg", "webp"],
                    "default": "png"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/qwen/qwen-image-2.1/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"],
                    "default": "1:1"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["1K", "2K"],
                    "default": "1K"
                  },
                  "guidance_scale": {
                    "type": "number",
                    "maximum": 10.0,
                    "minimum": 1.0,
                    "default": 1
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 2147483647.0,
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["png", "jpeg", "webp"],
                    "default": "png"
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 10,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
