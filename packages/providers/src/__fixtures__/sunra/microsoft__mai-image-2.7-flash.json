{
  "openapi": "3.0.0",
  "info": {
    "title": "MAI Image 2.7 Flash API",
    "docs": "https://oapi.sunra.ai/main/microsoft/mai-image-2.7-flash/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/microsoft/mai-image-2.7-flash/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 5461.0,
                        "minimum": 768.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 5461.0,
                        "minimum": 768.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/microsoft/mai-image-2.7-flash/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image_urls": {
                    "items": {
                      "type": "string",
                      "maxLength": 2083,
                      "minLength": 1,
                      "format": "uri"
                    },
                    "type": "array",
                    "maxItems": 5,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
