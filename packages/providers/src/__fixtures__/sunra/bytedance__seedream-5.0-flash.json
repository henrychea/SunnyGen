{
  "openapi": "3.0.0",
  "info": {
    "title": "Seedream 5.0 Flash API",
    "docs": "https://oapi.sunra.ai/main/bytedance/seedream-5.0-flash/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/bytedance/seedream-5.0-flash/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "4:3", "3:4", "16:9", "9:16", "3:2", "2:3", "21:9"],
                    "default": "1:1"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["1K", "2K"],
                    "default": "2K"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  },
                  "enable_safety_checker": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/bytedance/seedream-5.0-flash/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "4:3", "3:4", "16:9", "9:16", "3:2", "2:3", "21:9"],
                    "default": "1:1"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["1K", "2K"],
                    "default": "2K"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  },
                  "enable_safety_checker": {
                    "type": "boolean",
                    "default": true
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 10,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
