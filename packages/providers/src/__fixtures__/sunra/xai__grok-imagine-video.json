{
  "openapi": "3.0.0",
  "info": {
    "title": "xAI Grok Imagine Video API",
    "docs": "https://oapi.sunra.ai/main/xai/grok-imagine-video/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/xai/grok-imagine-video/text-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 4096,
                    "minLength": 1
                  },
                  "duration": {
                    "type": "integer",
                    "maximum": 15.0,
                    "minimum": 1.0,
                    "default": 6
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["16:9", "4:3", "3:2", "1:1", "2:3", "3:4", "9:16"],
                    "default": "16:9"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p"],
                    "default": "720p"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-video/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 4096,
                    "minLength": 1
                  },
                  "image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1,
                        "format": "uri"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "duration": {
                    "type": "integer",
                    "maximum": 15.0,
                    "minimum": 1.0,
                    "default": 6
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["auto", "16:9", "4:3", "3:2", "1:1", "2:3", "3:4", "9:16"],
                    "default": "auto"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p"],
                    "default": "720p"
                  }
                },
                "type": "object",
                "required": ["prompt", "image"]
              }
            }
          }
        }
      }
    },
    "/xai/grok-imagine-video/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 4096,
                    "minLength": 1
                  },
                  "reference_images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  "duration": {
                    "type": "integer",
                    "maximum": 10.0,
                    "minimum": 1.0,
                    "default": 8
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["16:9", "4:3", "3:2", "1:1", "2:3", "3:4", "9:16"],
                    "default": "16:9"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p"],
                    "default": "480p"
                  }
                },
                "type": "object",
                "required": ["prompt", "reference_images"]
              }
            }
          }
        }
      }
    }
  }
}
