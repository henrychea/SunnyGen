{
  "openapi": "3.0.0",
  "info": {
    "title": "Doubao Seedance 2.0 API",
    "docs": "https://oapi.sunra.ai/main/bytedance/seedance-2.0/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/bytedance/seedance-2.0/text-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p", "4k"],
                    "default": "720p"
                  },
                  "ratio": {
                    "type": "string",
                    "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"],
                    "default": "adaptive"
                  },
                  "duration": {
                    "type": "integer",
                    "default": 5
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedance-2.0/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["start_image"],
                "properties": {
                  "prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "start_image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "end_image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p", "4k"],
                    "default": "720p"
                  },
                  "ratio": {
                    "type": "string",
                    "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"],
                    "default": "adaptive"
                  },
                  "duration": {
                    "type": "integer",
                    "default": 5
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bytedance/seedance-2.0/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "reference_images": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 9,
                        "minItems": 0,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "reference_videos": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 3,
                        "minItems": 0,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "reference_audios": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 3,
                        "minItems": 0,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p", "4k"],
                    "default": "720p"
                  },
                  "ratio": {
                    "type": "string",
                    "enum": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "adaptive"],
                    "default": "adaptive"
                  },
                  "duration": {
                    "type": "integer",
                    "default": 5
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
