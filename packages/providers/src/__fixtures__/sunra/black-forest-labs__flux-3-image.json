{
  "openapi": "3.0.0",
  "info": {
    "title": "FLUX 3 Image API",
    "docs": "https://oapi.sunra.ai/main/black-forest-labs/flux-3-image/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/black-forest-labs/flux-3-image/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "21:9",
                      "2:1",
                      "16:9",
                      "3:2",
                      "7:5",
                      "4:3",
                      "5:4",
                      "1:1",
                      "4:5",
                      "3:4",
                      "5:7",
                      "2:3",
                      "9:16",
                      "1:2"
                    ],
                    "default": "auto"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["768sq", "1k", "2k", "4k"],
                    "default": "1k"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/black-forest-labs/flux-3-image/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "21:9",
                      "2:1",
                      "16:9",
                      "3:2",
                      "7:5",
                      "4:3",
                      "5:4",
                      "1:1",
                      "4:5",
                      "3:4",
                      "5:7",
                      "2:3",
                      "9:16",
                      "1:2"
                    ],
                    "default": "auto"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["768sq", "1k", "2k", "4k"],
                    "default": "1k"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  },
                  "image_urls": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 10,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
