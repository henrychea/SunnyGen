{
  "openapi": "3.0.0",
  "info": {
    "title": "Veo3.1 Lite (GCP) API",
    "docs": "https://oapi.sunra.ai/main/google/veo3-1-lite/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/google/veo3-1-lite/text-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "negative_prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["16:9", "9:16"],
                    "default": "16:9"
                  },
                  "duration": {
                    "type": "integer",
                    "enum": [4, 6, 8],
                    "default": 8
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["720p", "1080p"],
                    "default": "720p"
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/google/veo3-1-lite/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt", "image"],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "negative_prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "end_image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["auto", "16:9", "9:16"],
                    "default": "auto"
                  },
                  "duration": {
                    "type": "integer",
                    "enum": [4, 6, 8],
                    "default": 8
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["720p", "1080p"],
                    "default": "720p"
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
