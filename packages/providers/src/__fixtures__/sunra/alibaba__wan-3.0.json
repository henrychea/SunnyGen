{
  "openapi": "3.0.0",
  "info": {
    "title": "Wan 3.0 API",
    "docs": "https://oapi.sunra.ai/main/alibaba/wan-3.0/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/alibaba/wan-3.0/text-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "duration": {
                    "default": 5,
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"],
                    "default": "adaptive"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p"],
                    "default": "1080p"
                  },
                  "audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "enable_thinking": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alibaba/wan-3.0/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["start_image"],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "start_image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "end_image": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "duration": {
                    "default": 5,
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"],
                    "default": "adaptive"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p"],
                    "default": "1080p"
                  },
                  "audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "enable_thinking": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alibaba/wan-3.0/reference-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "reference_images": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "reference_videos": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "reference_audios": {
                    "anyOf": [
                      {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 2083,
                              "minLength": 1
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "web_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "file_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 2083,
                        "minLength": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "duration": {
                    "default": 5,
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"],
                    "default": "adaptive"
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["480p", "720p", "1080p"],
                    "default": "1080p"
                  },
                  "audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "enable_thinking": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
