{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAI GPT Image 1.5 API",
    "docs": "https://oapi.sunra.ai/main/openai/gpt-image-1.5/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/openai/gpt-image-1.5/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 32000,
                    "minLength": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "3:2", "2:3"],
                    "default": "1:1"
                  },
                  "quality": {
                    "type": "string",
                    "enum": ["high", "medium", "low"],
                    "default": "high"
                  },
                  "background": {
                    "type": "string",
                    "enum": ["auto", "transparent", "opaque"],
                    "default": "auto"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "png"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/openai/gpt-image-1.5/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 32000,
                    "minLength": 1
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 16,
                    "minItems": 1
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["auto", "1:1", "3:2", "2:3"],
                    "default": "auto"
                  },
                  "quality": {
                    "type": "string",
                    "enum": ["high", "medium", "low"],
                    "default": "high"
                  },
                  "background": {
                    "type": "string",
                    "enum": ["auto", "transparent", "opaque"],
                    "default": "auto"
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "png"
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
