{
  "openapi": "3.0.0",
  "info": {
    "title": "MiniMax H3 Image API",
    "docs": "https://oapi.sunra.ai/main/minimax/minimax-h3-image/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/minimax/minimax-h3-image/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 32000,
                    "minLength": 1
                  },
                  "n": {
                    "type": "integer",
                    "maximum": 10.0,
                    "minimum": 1.0,
                    "default": 1
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp", "jpg"],
                    "default": "png"
                  },
                  "width": {
                    "type": "integer",
                    "maximum": 14142.0,
                    "minimum": 1.0,
                    "default": 2048
                  },
                  "height": {
                    "type": "integer",
                    "maximum": 14142.0,
                    "minimum": 1.0,
                    "default": 2048
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/minimax/minimax-h3-image/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 32000,
                    "minLength": 1
                  },
                  "n": {
                    "type": "integer",
                    "maximum": 10.0,
                    "minimum": 1.0,
                    "default": 1
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp", "jpg"],
                    "default": "png"
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 16,
                    "minItems": 1
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 14142.0,
                        "minimum": 1.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 14142.0,
                        "minimum": 1.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
