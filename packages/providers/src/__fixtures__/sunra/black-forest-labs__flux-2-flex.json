{
  "openapi": "3.0.0",
  "info": {
    "title": "Black Forest Labs API",
    "docs": "https://oapi.sunra.ai/main/black-forest-labs/flux-2-flex/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/black-forest-labs/flux-2-flex/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["1:1", "4:3", "3:4", "16:9", "9:16"],
                    "default": "4:3"
                  },
                  "seed": {
                    "type": "integer",
                    "maximum": 2147483647.0,
                    "minimum": 0.0
                  },
                  "guidance_scale": {
                    "type": "number",
                    "maximum": 10.0,
                    "minimum": 1.5,
                    "default": 3.5
                  },
                  "num_inference_steps": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 2.0,
                    "default": 28
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/black-forest-labs/flux-2-flex/image-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["auto", "1:1", "4:3", "3:4", "16:9", "9:16"],
                    "default": "auto"
                  },
                  "seed": {
                    "type": "integer",
                    "maximum": 2147483647.0,
                    "minimum": 0.0
                  },
                  "guidance_scale": {
                    "type": "number",
                    "maximum": 10.0,
                    "minimum": 1.5,
                    "default": 3.5
                  },
                  "num_inference_steps": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 2.0,
                    "default": 28
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png"],
                    "default": "jpeg"
                  },
                  "image_urls": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array"
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
