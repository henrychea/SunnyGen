{
  "openapi": "3.0.0",
  "info": {
    "title": "Qwen Image Edit Multiple Angles API",
    "docs": "https://oapi.sunra.ai/main/qwen/qwen-image-edit-multiple-angles/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/qwen/qwen-image-edit-multiple-angles/image-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 1,
                    "minItems": 1
                  },
                  "aspect_ratio": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["1:1", "16:9", "9:16", "4:3", "3:4"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "guidance_scale": {
                    "type": "number",
                    "maximum": 20.0,
                    "minimum": 1.0,
                    "default": 4.5
                  },
                  "num_inference_steps": {
                    "type": "integer",
                    "maximum": 50.0,
                    "minimum": 1.0,
                    "default": 28
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["png", "jpeg", "webp"],
                    "default": "png"
                  }
                },
                "type": "object",
                "required": ["images"]
              }
            }
          }
        }
      }
    }
  }
}
