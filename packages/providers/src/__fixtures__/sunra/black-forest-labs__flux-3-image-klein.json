{
  "openapi": "3.0.0",
  "info": {
    "title": "FLUX 3 Image Klein API",
    "docs": "https://oapi.sunra.ai/main/black-forest-labs/flux-3-image-klein/ddf6cb742904d9f8bc15081a014eb7c7ba010943.json"
  },
  "paths": {
    "/black-forest-labs/flux-3-image-klein/text-to-image": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 10000,
                    "minLength": 1
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 4096.0,
                        "minimum": 256.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 4096.0,
                        "minimum": 256.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "png"
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object",
                "required": ["prompt"]
              }
            }
          }
        }
      }
    },
    "/black-forest-labs/flux-3-image-klein/image-editing": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string",
                    "maxLength": 10000,
                    "minLength": 1
                  },
                  "width": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 4096.0,
                        "minimum": 256.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "height": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "maximum": 4096.0,
                        "minimum": 256.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"],
                    "default": "png"
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0.0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "images": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 2083,
                          "minLength": 1,
                          "format": "uri"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "type": "array",
                    "maxItems": 10,
                    "minItems": 1
                  }
                },
                "type": "object",
                "required": ["prompt", "images"]
              }
            }
          }
        }
      }
    }
  }
}
