{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-2-pro/edit",
    "docs": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/flux-2-pro/edit"
  },
  "paths": {
    "/fal-ai/flux-2-pro/edit": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "image_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "image_size": {
                    "anyOf": [
                      {
                        "properties": {
                          "height": {
                            "default": 512,
                            "exclusiveMinimum": 0,
                            "type": "integer",
                            "maximum": 14142
                          },
                          "width": {
                            "default": 512,
                            "exclusiveMinimum": 0,
                            "type": "integer",
                            "maximum": 14142
                          }
                        },
                        "type": "object",
                        "title": "ImageSize"
                      },
                      {
                        "enum": [
                          "auto",
                          "square_hd",
                          "square",
                          "portrait_4_3",
                          "portrait_16_9",
                          "landscape_4_3",
                          "landscape_16_9"
                        ],
                        "type": "string"
                      }
                    ],
                    "default": "auto"
                  },
                  "output_format": {
                    "enum": ["jpeg", "png"],
                    "default": "jpeg",
                    "type": "string"
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "enable_safety_checker": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
