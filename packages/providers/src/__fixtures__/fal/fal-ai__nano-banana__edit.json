{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/nano-banana/edit",
    "docs": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/nano-banana/edit"
  },
  "paths": {
    "/fal-ai/nano-banana/edit": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "output_format": {
                    "default": "png",
                    "type": "string",
                    "enum": ["jpeg", "png", "webp"]
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50000
                  },
                  "num_images": {
                    "maximum": 4,
                    "default": 1,
                    "type": "integer",
                    "minimum": 1
                  },
                  "image_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "aspect_ratio": {
                    "default": "auto",
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "auto",
                          "21:9",
                          "16:9",
                          "3:2",
                          "4:3",
                          "5:4",
                          "1:1",
                          "4:5",
                          "3:4",
                          "2:3",
                          "9:16"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
