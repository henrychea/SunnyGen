{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for openai/gpt-image-2.5/sunburst/edit",
    "docs": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=openai/gpt-image-2.5/sunburst/edit"
  },
  "paths": {
    "/openai/gpt-image-2.5/sunburst/edit": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prompt": {
                    "maxLength": 32000,
                    "minLength": 1,
                    "type": "string"
                  },
                  "quality": {
                    "default": "high",
                    "enum": ["auto", "low", "medium", "high", "xhigh", "max"],
                    "type": "string"
                  },
                  "enable_safety_checker": {
                    "default": true,
                    "type": "boolean"
                  },
                  "output_compression": {
                    "anyOf": [
                      {
                        "maximum": 100,
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "image_urls": {
                    "maxItems": 16,
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "background": {
                    "default": "auto",
                    "enum": ["auto", "transparent", "opaque"],
                    "type": "string"
                  },
                  "mask_url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "image_size": {
                    "default": "auto",
                    "anyOf": [
                      {
                        "properties": {
                          "height": {
                            "maximum": 14142,
                            "default": 512,
                            "exclusiveMinimum": 0,
                            "type": "integer"
                          },
                          "width": {
                            "maximum": 14142,
                            "default": 512,
                            "exclusiveMinimum": 0,
                            "type": "integer"
                          }
                        },
                        "type": "object",
                        "title": "ImageSize"
                      },
                      {
                        "enum": [
                          "square_hd",
                          "square",
                          "portrait_4_3",
                          "portrait_16_9",
                          "landscape_4_3",
                          "landscape_16_9",
                          "auto"
                        ],
                        "type": "string"
                      }
                    ]
                  },
                  "num_images": {
                    "maximum": 10,
                    "default": 1,
                    "type": "integer",
                    "minimum": 1
                  },
                  "output_format": {
                    "default": "png",
                    "enum": ["jpeg", "png", "webp"],
                    "type": "string"
                  }
                },
                "type": "object",
                "required": ["prompt", "image_urls"]
              }
            }
          }
        }
      }
    }
  }
}
