{
  "openapi": "3.1.0",
  "info": {
    "title": "Queue OpenAPI for fal-ai/veo3.1/fast",
    "docs": "https://fal.ai/api/openapi/queue/openapi.json?endpoint_id=fal-ai/veo3.1/fast"
  },
  "paths": {
    "/fal-ai/veo3.1/fast": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "auto_fix": {
                    "type": "boolean",
                    "default": true
                  },
                  "duration": {
                    "type": "string",
                    "enum": ["4s", "6s", "8s"],
                    "default": "8s"
                  },
                  "generate_audio": {
                    "type": "boolean",
                    "default": true
                  },
                  "negative_prompt": {
                    "anyOf": [
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "resolution": {
                    "type": "string",
                    "enum": ["720p", "1080p", "4k"],
                    "default": "720p"
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": ["16:9", "9:16"],
                    "default": "16:9"
                  },
                  "seed": {
                    "anyOf": [
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "safety_tolerance": {
                    "type": "string",
                    "enum": ["1", "2", "3", "4", "5", "6"],
                    "default": "4"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 20000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
