# SunnyGen is local-first: every value here is optional. API keys are normally
# saved in-app under Settings → Providers and stored in the local SQLite file.
# The launcher reads .env first, then .env.local; real environment variables win.

# Fallback provider keys when nothing is saved in Settings.
SUNRA_API_KEY=
FAL_KEY=
AZURE_API_KEY=
OPENROUTER_API_KEY=

# Cobalt (social media import) runs as a Docker container. The launcher starts
# it when Docker is available; the app defaults to localhost:9000.
# COBALT_API_URL=http://127.0.0.1:9000/
# COBALT_API_KEY=

# Server and launcher defaults.
# PORT=8977
# MDNS_NAME=sunnygen

# Move the SQLite database and generated media.
# SUNNYGEN_DATA_DIR=./data
# SUNNYGEN_MEDIA_DIR=./data/media

# Cloudflare Tunnel connector, used by ./sunnygen --tunnel.
# CLOUDFLARE_TUNNEL_TOKEN=
